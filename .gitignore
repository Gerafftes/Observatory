.DS_Store
**/.DS_Store

# Python/runtime byproducts
__pycache__/
*.pyc
.venv/

# Private measurement and runtime data stay local. Public reports and
# aggregate CSV files belong under results/ instead.
data/raw/
logs/
**/data/recordings/
*.sqlite3
*.sqlite3-*

# Credentials and device-specific provisioning exports.
.env
.env.*
!.env.example
**/nvs_*.bin
**/nvs_*.csv
CLAUDE.local.md
.mcp.json

# Generated software outputs. The source snapshot under software/ruview/
# remains reproducible from its manifests and lockfiles.
**/target/
**/node_modules/
**/.vite/
firmware/**/build/
firmware/**/managed_components/
firmware/**/dependencies.lock
firmware/**/sdkconfig
firmware/**/sdkconfig.old

# Local BLL workspace material; do not publish with Observatory.
devlogs/
/.toolchains/
/.wakatime-project
/private/
/artifacts/
/*.pdf
/data/mmwave/
/data/models/
**/data/mmwave/
**/data/calibrations/
software/ruview/archive/**/data/*.db
software/ruview/vendor/ruvector/ui/ruvocal/.env.ci
**/*.kicad_prl
**/*.lck
