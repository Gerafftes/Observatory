# Shared S3 measurement image. Device identity, board and topology live in NVS.
# Apply after sdkconfig.defaults; never use an existing per-device sdkconfig.
CONFIG_RX_UNIFIED=y
CONFIG_CSI_RAW_PROFILE=y
CONFIG_CSI_FRAME_HE_TAGGING=y
CONFIG_CSI_NODE_ID=0
CONFIG_CSI_WIFI_SSID=""
CONFIG_CSI_WIFI_PASSWORD=""
CONFIG_CSI_TARGET_IP="0.0.0.0"
CONFIG_EDGE_TIER=0
CONFIG_CSI_SELF_PING_ENABLE=y
CONFIG_CSI_SELF_PING_INTERVAL_MS=20
CONFIG_CSI_SELF_PING_TIMEOUT_MS=1000
CONFIG_CSI_CAPTURE_RATE_LIMIT_HZ=50
CONFIG_CSI_TRANSPORT_CAPTURE_SLOTS=8
CONFIG_CSI_TRANSPORT_TASK_STACK_BYTES=8192
CONFIG_CSI_TRANSPORT_TASK_PRIORITY=5
CONFIG_CSI_TRANSPORT_TASK_CORE=-1
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_WASM_ENABLE=n
CONFIG_DISPLAY_ENABLE=n
