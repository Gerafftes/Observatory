# Opt-in ESP32-S3 raw-RX baseline overlay. Not selected by normal builds.
# Combine after sdkconfig.defaults via SDKCONFIG_DEFAULTS.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_CSI_RAW_PROFILE=y
CONFIG_EDGE_TIER=0
CONFIG_CSI_SELF_PING_ENABLE=y
CONFIG_CSI_CAPTURE_RATE_LIMIT_HZ=50
CONFIG_CSI_TRANSPORT_CAPTURE_SLOTS=8
CONFIG_CSI_TRANSPORT_TASK_STACK_BYTES=8192
CONFIG_CSI_TRANSPORT_TASK_PRIORITY=5
CONFIG_CSI_TRANSPORT_TASK_CORE=-1
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
